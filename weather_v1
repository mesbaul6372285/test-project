import requests

def get_weather(lat, lon):
    url = "https://api.open-meteo.com/v1/forecast"

    params = {
        "latitude": lat,
        "longitude": lon,
        "current": ["temperature_2m", "relative_humidity_2m", "wind_speed_10m"],
        "timezone": "auto"
    }

    try:
        # Note: the library is 'requests' and the argument is 'params'
        response = requests.get(url, params=params)
        response.raise_for_status()
        data = response.json()

        current = data["current"]
        units = data["current_units"]

        # Added quotes to fix the SyntaxError
        print("------Weather------")
        print(f"Location: Lat {lat}, Lon {lon}")
        print(f"Time: {current['time']}")
        print(f"Temperature: {current['temperature_2m']}{units['temperature_2m']}")
        print(f"Humidity: {current['relative_humidity_2m']}{units['relative_humidity_2m']}")
        print(f"Wind Speed: {current['wind_speed_10m']}{units['wind_speed_10m']}")

    except Exception as e:
        print(f"Error: {e}")

